# Environment selection: local | dev | staging
TEST_ENV=local

# Override base URLs (optional — defaults come from config/envs/<env>.ts)
# BASE_URL=http://localhost:8080
# API_BASE_URL=http://localhost:8080/api/v1

# Optional pre-provisioned admin credentials (used for API seeding when provided).
# When omitted, the framework registers an ephemeral admin user per worker.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_EMAIL=

# Test execution
HEADLESS=true
SLOW_MO=0
WORKERS=4
RETRIES=0
TRACE=on-first-retry
